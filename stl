#include <iostream>
#include <vector>
using namespace std;
template <typename T>
class Stack
{
    vector<T> v;
public:
    void push(T x) { v.push_back(x); }
    void pop()
    {
        if (v.empty()) throw "Stack Empty";
        v.pop_back();
    }
    void display()
    {
        for (auto &i : v)
            cout << i << " ";
    }
};
int main()
{
    Stack<int> s;
    s.push(10);
    s.push(20);
    s.display();
}