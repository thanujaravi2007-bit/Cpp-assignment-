#include <iostream>
#include <fstream>
using namespace std;
template <typename T>
void writeToFile(const string& filename, T data)
{
    ofstream file(filename, ios::app); 
    if (!file)
    {
        cout << "Error opening file!" << endl;
        return;
    }
    file << data << endl;
    file.close();
}
template <typename T>
void readFromFile(const string& filename)
{
    ifstream file(filename);
    T data;
    if (!file)
    {
        cout << "Error opening file!" << endl;
        return;
    }
    cout << "File contents:" << endl;
    while (file >> data)
    {
        cout << data << endl;
    }
    file.close();
}
int main()
{
    writeToFile<int>("data.txt", 100);
    writeToFile<float>("data.txt", 25.5);
    writeToFile<char>("data.txt", 'A');
    readFromFile<string>("data.txt");
    return 0;
}