#include <iostream>
using namespace std;
class Base 
{
public:
    virtual void display()
    {
        cout << "Base Display";
    }
};
class Derived : public Base 
{
public:
    void display()
    {
        cout << "Derived Display";
    }
};
int main() 
{
    Base* ptr;
    Derived d;
    ptr = &d;
    ptr->display();
}